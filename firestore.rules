rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function friendshipMember(pairId) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(pairId))
        && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pairId)).data.memberUids;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      // User documents may contain email and phone number; keep them private.
      allow read: if isSelf(uid) || isOwner();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'email', 'phoneNumber',
          'bio', 'lastSignInAt', 'updatedAt', 'createdAt'
        ]);

      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'email', 'phoneNumber',
          'bio', 'lastSignInAt', 'updatedAt'
        ]);

      allow delete: if isOwner();
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);

      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // Friendship records are created by trusted server code only after a request is accepted.
    match /friendships/{pairId} {
      allow read: if friendshipMember(pairId);
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if friendshipMember(conversationId)
        && request.auth.uid in resource.data.memberUids;

      allow create: if friendshipMember(conversationId)
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids
          == get(/databases/$(database)/documents/friendships/$(conversationId)).data.memberUids;

      allow update: if friendshipMember(conversationId)
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageAt', 'lastMessagePreview'
        ]);

      allow delete: if isOwner();

      match /messages/{messageId} {
        function conversationMember() {
          return friendshipMember(conversationId)
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.memberUids;
        }

        allow read: if conversationMember();

        allow create: if conversationMember()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        // A sender may edit only the message text, never its sender or metadata.
        allow update: if conversationMember()
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        allow delete: if conversationMember()
          && resource.data.senderUid == request.auth.uid;
      }
    }

    match /rooms/{roomId} {
      allow read: if signedIn()
        && (resource.data.visibility == 'public'
          || resource.data.ownerUid == request.auth.uid
          || isRoomMember(roomId));

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40;

      allow update: if isOwner()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.visibility == resource.data.visibility
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'category', 'coverClass', 'symbol', 'updatedAt'
          ]));

      allow delete: if isOwner()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      match /members/{uid} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/rooms/$(roomId)).data.visibility == 'public'
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
            || isRoomMember(roomId));

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && (
            (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.visibility == 'public'
              && (
                (get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == uid
                  && request.resource.data.role == 'owner')
                || (get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid != uid
                  && request.resource.data.role == 'member')
              )
            )
            || (
              get(/databases/$(database)/documents/rooms/$(roomId)).data.visibility == 'private'
              && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == uid
              && request.resource.data.role == 'owner'
            )
          );

        allow update: if signedIn()
          && request.auth.uid == uid
          && resource.data.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'joinedAt'
          ]);

        allow delete: if signedIn()
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
            || isOwner());
      }
    }

    match /moments/{momentId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorPhotoURL', 'text',
          'mediaUrl', 'mediaType', 'likesCount', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.likesCount == 0
        && request.resource.data.mediaType in [null, 'image', 'video']
        && (
          (request.resource.data.mediaType == null
            && request.resource.data.mediaUrl == null)
          || (request.resource.data.mediaType in ['image', 'video']
            && request.resource.data.mediaUrl is string
            && request.resource.data.mediaUrl.size() > 0
            && request.resource.data.mediaUrl.size() <= 2048)
        );

      allow update: if signedIn() && (
        (
          resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
          && request.resource.data.likesCount is int
          && (
            (
              request.resource.data.likesCount == resource.data.likesCount + 1
              && !exists(/databases/$(database)/documents/moments/$(momentId)/likes/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/moments/$(momentId)/likes/$(request.auth.uid))
            )
            || (
              request.resource.data.likesCount == resource.data.likesCount - 1
              && exists(/databases/$(database)/documents/moments/$(momentId)/likes/$(request.auth.uid))
              && !existsAfter(/databases/$(database)/documents/moments/$(momentId)/likes/$(request.auth.uid))
            )
          )
        )
      );

      allow delete: if isOwner() || (signedIn() && resource.data.authorUid == request.auth.uid);

      match /likes/{uid} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt']);

        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /reports/{reportId} {
        allow create: if signedIn()
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 200
          && request.resource.data.status == 'open';

        allow read, update, delete: if isOwner();
      }

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow delete: if isOwner()
          || (signedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // Balances and financial ledgers are server-only for writes.
    match /wallets/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isOwner());
      allow write: if false;
    }

    // Deny every collection not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}